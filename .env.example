# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase.
# NUNCA coloque a service_role key aqui. Utilize somente a chave publica (anon/publishable).

# URL do projeto Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica anon/publishable (Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Nome do servico usado pelo "keyring" para isolar as credenciais de sessao salvas
# neste computador. Pode manter o padrao.
APP_KEYRING_SERVICE=HubiTime

# Nivel de log da aplicacao: DEBUG, INFO, WARNING, ERROR
APP_LOG_LEVEL=INFO
